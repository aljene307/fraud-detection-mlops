# Identifiants de DEVELOPPEMENT LOCAL uniquement.
#
#   copy .env.example .env        (Windows)
#   cp   .env.example .env        (Linux / macOS)
#
# Le fichier .env reel est ignore par git (voir .gitignore). Ces valeurs ne
# protegent rien : elles n'existent que pour que MinIO demarre sur ta machine.
# En Phase 5, Kubernetes fournira de vrais secrets, et en production ce seront
# des identifiants IAM.

# Compte administrateur MinIO. MinIO exige un mot de passe d'au moins 8
# caracteres et refuse de demarrer en dessous.
MINIO_ROOT_USER=fraud-dev
MINIO_ROOT_PASSWORD=fraud-dev-password

# Nom du bucket qui recevra les artefacts MLflow (modeles, courbes, rapports).
MLFLOW_BUCKET=mlflow
