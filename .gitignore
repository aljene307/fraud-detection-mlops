# Data — creditcard.csv is ~144MB; pulled by `python -m src.data.download`
# NOTE the leading slash: it anchors this to the repo root. Without it, `data/`
# would also match the source package src/data/ and silently un-track its code.
/data/

# MLflow local tracking + artifact store
mlruns/
mlartifacts/

# Secrets — never commit the Kaggle API token
.env
kaggle.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated drift reports and plots
reports/

# OS / editor
.DS_Store
Thumbs.db
